{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx -y pnpm@12.11.2 install --frozen-lockfile",
  "buildCommand": "VITE_SOCKET_TRANSPORTS=polling npx -y pnpm@12.11.2 build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nexus-backend-12c9.onrender.com/api/:path*" },
    { "source": "/healthz", "destination": "https://nexus-backend-12c9.onrender.com/healthz" },
    { "source": "/socket.io/:path*", "destination": "https://nexus-backend-12c9.onrender.com/socket.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
