# Copy to .env — loaded by `pnpm dev` (apps/api) and docker compose.
NODE_ENV=development
PORT=4000
# Local dev uses the embedded Postgres started by `pnpm dev:db` (port 54329). Docker Compose overrides this.
DATABASE_URL=postgres://nexus:nexus@127.0.0.1:54329/nexus
WEB_ORIGIN=http://localhost:5273
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
LOG_LEVEL=info

# Simulation (telemetry is simulated, deterministic from wall-clock time)
SIM_ENABLED=true
SIM_CHAOS=on            # periodically injects deterministic faults so alerts/incidents come alive
SIM_TICK_MS=2000
ALERT_EVAL_MS=10000

# Optional AI provider for incident summaries. Leave AI_PROVIDER=none to use the deterministic rule-based engine.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5-5

# Demo accounts password used by the seed script. NEVER reuse in production.
SEED_PASSWORD=nexus-demo-2026
POSTGRES_PASSWORD=nexus
